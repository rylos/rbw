#!/bin/sh
# Salva un segreto per pinentry-rbw-nas, letto da stdin (mai da argomenti).
#   printf %s "$valore" | rbw-nas-secret set master
#   rbw-nas-secret check            (dice quali ci sono, senza mostrarli)
set -eu
DIR=${RBW_NAS_SECRETS:-$HOME/.config/rbw/secrets}
KEY=${RBW_NAS_KEY:-$HOME/.local/share/rbw/secrets.key}
umask 077
case "${1:-}" in
    set)
        case "${2:-}" in
            master|apikey-client-id|apikey-client-secret) ;;
            *) echo "uso: rbw-nas-secret set master|apikey-client-id|apikey-client-secret" >&2; exit 2 ;;
        esac
        mkdir -p "$DIR" "$(dirname "$KEY")"
        chmod 700 "$DIR" "$(dirname "$KEY")"
        [ -s "$KEY" ] || openssl rand -hex 32 > "$KEY"
        chmod 600 "$KEY"
        openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -pass "file:$KEY" -out "$DIR/$2.enc.tmp"
        mv "$DIR/$2.enc.tmp" "$DIR/$2.enc"
        chmod 600 "$DIR/$2.enc"
        ;;
    check)
        for s in master apikey-client-id apikey-client-secret; do
            if [ -r "$DIR/$s.enc" ] && n=$(openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass "file:$KEY" -in "$DIR/$s.enc" 2>/dev/null | wc -c) && [ "$n" -gt 0 ]; then
                echo "$s: ok ($n caratteri)"
            else
                echo "$s: manca"
            fi
        done
        ;;
    *) echo "uso: rbw-nas-secret set <nome> | check" >&2; exit 2 ;;
esac
